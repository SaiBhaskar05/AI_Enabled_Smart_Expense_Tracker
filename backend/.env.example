# ═══════════════════════════════════════════════════════════════
# Smart Expense Tracker - Backend Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB)
# Local: mongodb://localhost:27017/smart_expense_tracker
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/smart_expense_tracker
MONGODB_URI=mongodb://localhost:27017/smart_expense_tracker

# Authentication (JWT)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS - development)
FRONTEND_URL=http://localhost:5173

# ML Service
ML_API_URL=http://localhost:8000

# Email Configuration Options
# ─────────────────────────────────────────────────────────────
# OPTION A (Recommended for Render - Pure Free SMTP on Port 2525):
# Brevo (Sendinblue) free SMTP (300 free emails/day - Port 2525 is NEVER blocked on Render):
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=2525
# EMAIL_USER=your_brevo_account_email
# EMAIL_PASSWORD=your_brevo_smtp_key
# EMAIL_FROM=Smart Expense Tracker <your_email@domain.com>

# OPTION B (SendGrid SMTP on Port 2525):
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=2525
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your_sendgrid_api_key

# OPTION C (Instant 1-Click Free API - 3,000 free emails/month at resend.com):
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Smart Expense Tracker <onboarding@resend.dev>

# OPTION D (Gmail SMTP):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_google_app_password
EMAIL_FROM=Smart Expense Tracker <your_email@gmail.com>

# Google Gemini AI API Key (for Financial Copilot & Smart Insights)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

